# ---------------------------------------------------------------------------
# Java / Maven (backend/)
# ---------------------------------------------------------------------------
target/
build/
# KEPT DELIBERATELY THOUGH NOTHING MATCHES IT TODAY: this negation is the only
# thing that would let a maven wrapper past `*.jar` below, and `mvn wrapper:wrapper`
# is one command away. A guard is not dead code because it has not fired yet.
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
# Local stand-in for the Docker volume that holds the original protocol documents
# (maintenance.files.base-path). The documents are generated by the corpus seed, so
# they are reproducible and do not belong in git.
backend/data/

# ---------------------------------------------------------------------------
# Node / Angular (frontend/)
# ---------------------------------------------------------------------------
node_modules/
.angular/
dist/
tmp/
out-tsc/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ---------------------------------------------------------------------------
# Python (spike/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# ---------------------------------------------------------------------------
# Test & coverage output
# ---------------------------------------------------------------------------
coverage/
documentation/
.nyc_output/
# Playwright: the HTML report, the traces and screenshots kept from failed runs, and the browser
# binaries if anyone points the download cache at the repo. All reproducible, none of it reviewable.
playwright-report/
test-results/
blob-report/
.playwright/
/backend/target/site/jacoco/
*.lcov
surefire-reports/
failsafe-reports/
TEST-*.xml

# ---------------------------------------------------------------------------
# Secrets & local environment
# ---------------------------------------------------------------------------
# Only *.example files are versioned — never a real .env (see docker/.env.example).
.env
.env.*
!.env.example
!**/.env.example
# Per-environment templates (.env.prod.example and friends) are documentation,
# not secrets; only the real .env.prod they are copied to stays out.
!.env.*.example
!**/.env.*.example
# The ADR-002 spike keeps provider keys in spike/adr-002/.env, which the bare
# `.env` above already covers at any depth; spike/adr-002/.env.example is the
# versioned template and is un-ignored by the !**/.env.example line.
*.pem
*.key

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
# Nothing matches this today either, and it stays for the same reason as the maven
# wrapper above: the identical file is tracked at frontend/.vscode/extensions.json,
# so a shared recommendation list at the root is a pattern this repository already
# uses, and this line is what would let one be committed.
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
*.swp
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Generated artifacts
# ---------------------------------------------------------------------------
# Mermaid SVGs are generated from .mmd sources by docs/scripts/generate-diagrams.mjs
# and are NOT versioned; the gh-pages build regenerates them.
docs/**/diagrams/*.svg
