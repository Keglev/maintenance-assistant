{"openapi":"3.1.0","info":{"title":"maintenance-assistant API","description":"Search industrial maintenance protocols in natural language (DE/EN) and get answers with citations. Roles come from Keycloak; answers are filtered by role server-side.\n\n[← Back to the application](https://maintenance.smartsupply.com.de/)","license":{"name":"MIT","url":"https://opensource.org/licenses/MIT"},"version":"v1"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"tags":[{"name":"Query","description":"Question answering over the indexed maintenance protocols"},{"name":"Moderation","description":"Administrator review and removal of protocols"},{"name":"Ingestion","description":"Upload and indexing of maintenance protocols"},{"name":"System","description":"Public service information"}],"paths":{"/api/query":{"post":{"tags":["Query"],"summary":"Ask a question about one machine","description":"Embeds the question, retrieves the closest protocol chunks for that machine and answers in one of two modes. Mode A is grounded: every claim carries the source it came from, validated against what was actually retrieved. Mode B is a labelled general suggestion, returned when no stored protocol is close enough. The answer is written in the language of the question, and its depth depends on the caller's role.","operationId":"ask","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QueryRequest"}}},"required":true},"responses":{"503":{"description":"Provider unavailable or daily budget spent","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"400":{"description":"Empty question or unknown machine","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"Answered, in Mode A or Mode B","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QueryAnswer"}}}},"403":{"description":"Caller holds no shop-floor role","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QueryAnswer"}}}},"429":{"description":"Per-user rate limit exceeded (NFR-7)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/QueryAnswer"}}}}}}},"/api/protocols":{"post":{"tags":["Ingestion"],"summary":"Upload a protocol text file","description":"Stores the document on the volume, records it as RECEIVED and hands it to the indexer. Text files only — PDF and scan extraction is a later phase.","operationId":"upload","parameters":[{"name":"machine","in":"query","required":true,"schema":{"type":"string"}},{"name":"type","in":"query","required":true,"schema":{"type":"string"}},{"name":"errorCode","in":"query","required":false,"schema":{"type":"string"}},{"name":"title","in":"query","required":false,"schema":{"type":"string"}},{"name":"language","in":"query","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}},"required":["file"]}}}},"responses":{"400":{"description":"Unknown machine, bad field, or not UTF-8 text","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"413":{"description":"File larger than the configured limit","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"202":{"description":"Accepted; indexing runs asynchronously","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"403":{"description":"Caller is not a Schichtleiter","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"429":{"description":"Too many uploads; see Retry-After","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}}}}},"/api/ingestion/backlog":{"post":{"tags":["Ingestion"],"summary":"Queue unindexed protocols for indexing","description":"Finds protocols in the given statuses and hands them to the indexer. Idempotent: re-indexing replaces a protocol's chunks rather than adding to them. Defaults to RECEIVED; pass FAILED to retry failures.","operationId":"runBacklog","parameters":[{"name":"status","in":"query","required":false,"schema":{"type":"array","default":["RECEIVED"],"items":{"type":"string"}}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","format":"int32"}}],"responses":{"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/protocols/{id}/document":{"get":{"tags":["Ingestion"],"summary":"Download the original document a citation points at","description":"Streams the stored file from the volume. This is what makes a Mode A citation checkable rather than decorative.","operationId":"document","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"The document","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}},"403":{"description":"Caller holds no shop-floor role","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}},"404":{"description":"No such protocol, or its file is gone","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/api/protocols/mine":{"get":{"tags":["Ingestion"],"summary":"What happened to the protocols you uploaded","description":"The 50 most recent uploads of the calling user, newest first, with status RECEIVED / INDEXED / FAILED and the failure reason. Upload answers 202, so this is where a document becoming searchable is actually visible.","operationId":"myUploads","responses":{"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UploadStatus"}}}}}}}},"/api/moderation/protocols":{"get":{"tags":["Moderation"],"summary":"List every protocol in the corpus, newest first","description":"Paged. `size` is clamped to 50 — the corpus grows every time a protocol is uploaded, and an unpaged list of it is a page that gets slower forever. Optionally narrowed by machine, by a case-insensitive title substring and by an upload-date range. `titleContains`, `from` and `to` require `machineNo`: without it they answer with rows from machines the reviewer was not looking at. All four absent is the plain list.","operationId":"list","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":10}},{"name":"machineNo","in":"query","required":false,"schema":{"type":"string"}},{"name":"titleContains","in":"query","required":false,"schema":{"type":"string"}},{"name":"from","in":"query","required":false,"schema":{"type":"string","format":"date"}},{"name":"to","in":"query","required":false,"schema":{"type":"string","format":"date"}}],"responses":{"400":{"description":"A title or date filter was sent without a machine (`reason: MACHINE_REQUIRED_FOR_FILTER`)","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"One page of protocols","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProtocolPage"}}}},"403":{"description":"Caller is not an administrator","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProtocolPage"}}}}}}},"/api/moderation/protocols/{id}/document":{"get":{"tags":["Moderation"],"summary":"Read the original document of any protocol","description":"The same file the shop floor sees behind a citation, reachable by an administrator who holds no shop-floor role. Reviewing is not answering.","operationId":"document_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"400":{"description":"Bad Request","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"The document","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}},"403":{"description":"Caller is not an administrator","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}},"404":{"description":"No such protocol, or its file is gone","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/api/machines":{"get":{"tags":["Query"],"summary":"List the machines a question can be asked about","description":"Ordered by plant identifier. Unpaged: this is a fixed-size plant. Readable by an administrator too — the moderation filter needs it, and plant metadata carries nothing a protocol says.","operationId":"list_1","responses":{"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Machine"}}}}}}}},"/api/ingestion/status":{"get":{"tags":["Ingestion"],"summary":"Protocol counts by indexing status, and today's embedding usage","operationId":"status","responses":{"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{}}}}}}}},"/api/hello":{"get":{"tags":["System"],"summary":"Identity as the backend sees it","description":"Requires a valid Keycloak access token for the maintenance realm.","operationId":"hello","responses":{"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HelloResponse"}}}}},"security":[{"keycloak":[]}]}},"/api/health":{"get":{"tags":["System"],"summary":"Service status and version","description":"Public — no token required.","operationId":"health","responses":{"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}},"/api/moderation/protocols/{id}":{"delete":{"tags":["Moderation"],"summary":"Remove a protocol from the corpus, permanently","description":"Deletes its chunks, its row and its file. There is no undo and no soft delete: correcting a protocol is delete-then-reupload, so that no answer can cite text that changed underneath it (ADR-006).","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"400":{"description":"Bad Request","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"413":{"description":"Content Too Large","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"string"}}}}},"204":{"description":"Removed"},"403":{"description":"Caller is not an administrator"},"404":{"description":"No such protocol"}}}}},"components":{"schemas":{"QueryRequest":{"type":"object","properties":{"question":{"type":"string"},"machineId":{"type":"string","format":"uuid"}}},"Citation":{"type":"object","properties":{"label":{"type":"string"},"protocolId":{"type":"string","format":"uuid"},"title":{"type":"string"},"errorCode":{"type":"string"},"incidentDate":{"type":"string","format":"date"},"similarity":{"type":"number","format":"double"}}},"Claim":{"type":"object","properties":{"text":{"type":"string"},"source":{"type":"string"}}},"QueryAnswer":{"type":"object","properties":{"mode":{"type":"string","enum":["A","B"]},"answer":{"type":"string"},"language":{"type":"string"},"claims":{"type":"array","items":{"$ref":"#/components/schemas/Claim"}},"citations":{"type":"array","items":{"$ref":"#/components/schemas/Citation"}}}},"UploadStatus":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"machineNo":{"type":"string"},"title":{"type":"string"},"status":{"type":"string"},"failureReason":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"indexedAt":{"type":"string","format":"date-time"}}},"ModeratedProtocol":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"machineNo":{"type":"string"},"title":{"type":"string"},"protocolType":{"type":"string"},"errorCode":{"type":"string"},"uploadedBy":{"type":"string"},"uploadedAt":{"type":"string","format":"date-time"},"status":{"type":"string"},"chunkCount":{"type":"integer","format":"int32"}}},"ProtocolPage":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/ModeratedProtocol"}},"page":{"type":"integer","format":"int32"},"size":{"type":"integer","format":"int32"},"total":{"type":"integer","format":"int64"}}},"Machine":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"machineNo":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"},"location":{"type":"string"}}},"HelloResponse":{"type":"object","properties":{"username":{"type":"string"},"roles":{"type":"array","items":{"type":"string"}}}},"HealthResponse":{"type":"object","properties":{"status":{"type":"string"},"version":{"type":"string"}}}},"securitySchemes":{"keycloak":{"type":"http","description":"Keycloak access token for the maintenance realm. Issuer: http://localhost:8081/realms/maintenance","scheme":"bearer","bearerFormat":"JWT"}}}}