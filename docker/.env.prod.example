# Copy to .env.prod on the server and fill in real values:
#   cp .env.prod.example .env.prod
#
# .env.prod is git-ignored and must never be committed. Generate the secrets
# rather than inventing them:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
#
# The deployed file lives at /opt/maintenance-assistant/.env.prod, owned by the
# deploy user with mode 0600.

# --- Public hostnames -------------------------------------------------------
# Both must already resolve to this host: Caddy proves control of them to
# Let's Encrypt over port 80 before it can issue a certificate.
APP_DOMAIN=maintenance.smartsupply.com.de
AUTH_DOMAIN=auth.smartsupply.com.de

# Contact address for the ACME account. Expiry and validation problems are
# mailed here; an unset address means the first warning is an outage.
ACME_EMAIL=admin@smartsupply.com.de

# --- Images -----------------------------------------------------------------
# Per service rather than one shared tag, so one side can be rolled back without
# moving the other. CI publishes :latest and :sha-<commit>, and a rollback is a
# value change here plus `docker compose up -d`.
BACKEND_IMAGE=ghcr.io/keglev/maintenance-assistant/backend:latest
FRONTEND_IMAGE=ghcr.io/keglev/maintenance-assistant/frontend:latest

# --- Application database ---------------------------------------------------
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=generate-me

# --- Keycloak database ------------------------------------------------------
# Separate database and role in the same Postgres instance. Read once, when the
# data directory is initialised; see docker/postgres/init-keycloak-db.sh.
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=generate-me

# --- Keycloak bootstrap admin ----------------------------------------------
# Creates the master-realm administrator on first start. This is the Keycloak
# *server* administrator, not an application user: the four demo users live in
# the imported "maintenance" realm.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=generate-me

# --- LLM provider (Phase 3) -------------------------------------------------
# Empty until ADR-002 closes. No key belongs in a versioned file.
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
