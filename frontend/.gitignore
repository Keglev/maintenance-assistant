# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Generated reports — rebuilt by `npm run test:ci` and `npm run docs`,
# published to gh-pages by CI rather than committed.
/coverage
/documentation

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings
__screenshots__/
# ...EXCEPT the visual-regression baselines, which are the opposite of build output: they are the
# committed record a pull request is compared against, and a suite whose baselines are not in the
# repository has nothing to compare to. This line comes from the Angular CLI's default template and
# would silently have made the whole visual check a no-op — every run would have "generated missing
# baselines" and passed. See frontend/e2e/README.md.
!/e2e/__screenshots__/
!/e2e/__screenshots__/**

# System files
.DS_Store
Thumbs.db
