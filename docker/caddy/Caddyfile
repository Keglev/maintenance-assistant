# Caddy configuration for the maintenance-assistant deployment.
#
# Caddy obtains and renews Let's Encrypt certificates on its own; there is no
# certbot and no cron entry. That requires ports 80 and 443 to reach this
# container and the two hostnames to resolve to this host, both of which are
# preconditions of the deployment rather than settings here.
#
# Hostnames come from the environment so the same file serves any domain — see
# APP_DOMAIN / AUTH_DOMAIN in .env.prod.
#
# DEPLOYMENT: this file is NOT synced by the pipeline. CI pulls images and
# nothing else, so a change here has to be copied to the host by hand (with a
# .bak of the previous version) and Caddy reloaded — the same rule that already
# applies to docker-compose.prod.yml. See arc42 §7.4.
{
	# A contact address turns expiry warnings into email rather than silence.
	email {$ACME_EMAIL}
}

# ---------------------------------------------------------------------------
# The application: Angular at the root, the API under /api.
# ---------------------------------------------------------------------------
{$APP_DOMAIN} {
	encode zstd gzip

	# -------------------------------------------------------------------------
	# Security headers (ADR-005).
	#
	# The threat these address is a cross-site scripting bug in the SPA reading
	# the access token out of sessionStorage. They cannot address malware on the
	# user's own machine — nothing a web application ships can — and ADR-005 says
	# so rather than pretending otherwise.
	#
	# `defer` matters: the header ops run after the handler below has produced
	# its response, so these values win over anything nginx or the backend set
	# instead of being overwritten by the proxied response.
	# -------------------------------------------------------------------------
	header {
		defer

		# script-src 'self' is the load-bearing line: an injected inline script
		# is refused even if something manages to write one into the DOM.
		#
		# style-src needs 'unsafe-inline' and that is not laziness — Angular
		# injects component styles as <style> elements at runtime, and the only
		# way around it is a per-request nonce, which a statically served bundle
		# behind a reverse proxy has no way to produce. The residual risk is CSS
		# injection, not script execution. ADR-005 records it.
		#
		# connect-src has to include the Keycloak host: the discovery document
		# and the token endpoint are fetched from there by XHR.
		#
		# No blob: source is listed, and that is deliberate. Citations open the
		# protocol by pointing a new tab at an object URL (#26), and a top-level
		# navigation is governed by no CSP directive — frame-src and child-src
		# cover nested contexts, form-action covers form submissions, neither
		# covers window.open. The blob document then inherits this policy, which
		# costs it nothing because it is text/plain. If a click on a source ever
		# does raise a CSP violation in the console, add `blob:` to child-src —
		# never weaken script-src to fix it.
		Content-Security-Policy `default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://{$AUTH_DOMAIN}; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://{$AUTH_DOMAIN}`

		# frame-ancestors already forbids framing; this is the same statement for
		# browsers that predate it, and what a scanner looks for.
		X-Frame-Options DENY

		# The backend already sends this; the SPA did not. Aligned here so both
		# halves of the origin answer the same way.
		X-Content-Type-Options nosniff

		# A protocol id in a URL path must not leak to another site.
		Referrer-Policy strict-origin-when-cross-origin

		# This application asks for none of these, so the browser may refuse them
		# outright — including for anything it ever loads.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# Both hostnames are HTTPS-only already. No includeSubDomains and no
		# preload on purpose: other subdomains of this domain belong to other
		# projects and are not this deployment's to speak for.
		Strict-Transport-Security "max-age=31536000"

		# Caddy's own advertisement is of no use to a visitor and of some use to
		# someone matching versions against exploits.
		-Server
	}

	# Matched first, so /api/* never reaches the SPA. The backend maps its own
	# routes under /api, so the prefix is passed through rather than stripped.
	handle /api/* {
		reverse_proxy backend:8080 {
			# One id per request, set here and echoed back by the backend, so a single
			# grep lines up an access line with the WARN it produced, instead of matching
			# millisecond timestamps across two containers. Caddy OVERWRITES any inbound
			# value on purpose: this header is written to a log, and the edge is where a
			# client-supplied string stops being trusted.
			# The backend generates its own id when this header is absent, so correlation
			# already works without this file being deployed — it gets one hop wider when
			# this file next rides along with a hand-deploy (OPS RULE 3).
			# THE ACCESS LOG NEEDS NO CHANGE: `format console` already records this
			# request as a top-level "uuid" field, and it is the SAME value this header
			# carries — measured 2026-08-26 against caddy:2.10-alpine. Note that the
			# access line does NOT show the header itself: it logs the inbound request,
			# and header_up applies to the upstream copy. "uuid" is the field to grep.
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# The OpenAPI UI and spec, published deliberately: reachable API docs are a
	# requirement of the demo, and both are read-only.
	handle /swagger-ui* {
		reverse_proxy backend:8080 {
			# One id per request, set here and echoed back by the backend, so a single
			# grep lines up an access line with the WARN it produced, instead of matching
			# millisecond timestamps across two containers. Caddy OVERWRITES any inbound
			# value on purpose: this header is written to a log, and the edge is where a
			# client-supplied string stops being trusted.
			# The backend generates its own id when this header is absent, so correlation
			# already works without this file being deployed — it gets one hop wider when
			# this file next rides along with a hand-deploy (OPS RULE 3).
			# THE ACCESS LOG NEEDS NO CHANGE: `format console` already records this
			# request as a top-level "uuid" field, and it is the SAME value this header
			# carries — measured 2026-08-26 against caddy:2.10-alpine. Note that the
			# access line does NOT show the header itself: it logs the inbound request,
			# and header_up applies to the upstream copy. "uuid" is the field to grep.
			header_up X-Request-Id {http.request.uuid}
		}
	}
	handle /v3/api-docs* {
		reverse_proxy backend:8080 {
			# One id per request, set here and echoed back by the backend, so a single
			# grep lines up an access line with the WARN it produced, instead of matching
			# millisecond timestamps across two containers. Caddy OVERWRITES any inbound
			# value on purpose: this header is written to a log, and the edge is where a
			# client-supplied string stops being trusted.
			# The backend generates its own id when this header is absent, so correlation
			# already works without this file being deployed — it gets one hop wider when
			# this file next rides along with a hand-deploy (OPS RULE 3).
			# THE ACCESS LOG NEEDS NO CHANGE: `format console` already records this
			# request as a top-level "uuid" field, and it is the SAME value this header
			# carries — measured 2026-08-26 against caddy:2.10-alpine. Note that the
			# access line does NOT show the header itself: it logs the inbound request,
			# and header_up applies to the upstream copy. "uuid" is the field to grep.
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Everything else is the single-page application. nginx inside the container
	# already falls back to index.html, so deep links survive a reload.
	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format console
	}
}

# ---------------------------------------------------------------------------
# Keycloak on its own hostname.
# ---------------------------------------------------------------------------
{$AUTH_DOMAIN} {
	encode zstd gzip

	# Deliberately NO Content-Security-Policy here. Keycloak ships its own for
	# the login pages and the admin console, and replacing a policy written for
	# an application this deployment does not maintain is how a login page stops
	# rendering. Only the headers Keycloak does not already set are added.
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Keycloak reads X-Forwarded-* (KC_PROXY_HEADERS=xforwarded) to build issuer
	# and redirect URLs; Caddy sets them by default on reverse_proxy.
	reverse_proxy keycloak:8080

	log {
		output stdout
		format console
	}
}

# ---------------------------------------------------------------------------
# SmartSupplyPro backend (github.com/Keglev/inventory-service). Lives in its own
# compose project, /opt/smartsupplypro, and joins this project's network so the
# container name resolves here. Only Caddy is shared between the two projects.
# ---------------------------------------------------------------------------
api.smartsupplypro.de {
	encode gzip
	# The backend derives OAuth2 redirect URIs from X-Forwarded-Host. Caddy treats
	# the Koyeb proxy as untrusted and would replace the forwarded host with this
	# one; the canonical origin is the www host (inventory-service ADR-0010).
	reverse_proxy ssp-backend:8081 {
		header_up X-Forwarded-Host www.smartsupplypro.de
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
	}
}
