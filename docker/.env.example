# Copy to docker/.env before the first start:  cp docker/.env.example docker/.env
#
# docker/.env is git-ignored and must never be committed. These are local development
# values only — production secrets come from the deployment environment, not this file.

# --- PostgreSQL + pgvector -------------------------------------------------
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=change-me-locally
# Bound to localhost only, so the database is not exposed on the host's network.
POSTGRES_PORT=5432

# --- Keycloak --------------------------------------------------------------
# Bootstrap administrator of the Keycloak *server* (master realm), not an
# application user. Application users live in the imported "maintenance" realm.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_PORT=8081
# Where the login theme's "Zurück zur Startseite" link points. The local Angular dev server by
# default; production sets it to the public app hostname in its own compose file.
WA_HOME_URL=http://localhost:4200

# --- The application is NOT configured from this file ----------------------
# NOTHING BELONGS HERE FOR THE BACKEND, and that is the point rather than an
# omission. This file is read by `docker compose` and by nothing else, and the
# backend does not run in compose — it runs from the IDE or `mvn spring-boot:run`
# in a shell that never sees these values. Six settings sat here until 2026-08-25
# (APP_PORT, KEYCLOAK_ISSUER_URI and the four LLM_* ones) and reached nothing: a
# developer who filled in an API key here got no error and no effect.
#
# Where they actually go: application.yml carries a working default for every
# one of them (ADR-002 chose IONOS on 2026-08-06), so the usual answer is to set
# nothing at all. To override one, export it in the shell that starts the
# backend — frontend/e2e/README.md shows the invocation, including the free
# provider stub. DO NOT WRITE AN EMPTY ASSIGNMENT ANYWHERE: an empty value is a
# set value and overrides the default rather than deferring to it, which is the
# rule docker/.env.prod.example states in full.
