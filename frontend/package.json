{
  "name": "maintenance-assistant-frontend",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:headed": "playwright test --grep-invert @visual --headed",
    "e2e:report": "playwright show-report",
    "e2e:visual": "node e2e/run-visual-docker.mjs",
    "e2e:visual:update": "node e2e/run-visual-docker.mjs --update",
    "e2e:visual:bare": "playwright test --grep @visual",
    "docs": "compodoc -p tsconfig.doc.json -d documentation --hideGenerator",
    "docs:serve": "compodoc -p tsconfig.doc.json -d documentation -s"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "angular-oauth2-oidc": "^22.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@compodoc/compodoc": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
