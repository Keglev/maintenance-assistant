{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:application": {
      "testRunner": "vitest"
    },
    "@schematics/angular:library": {
      "testRunner": "vitest"
    }
  },
  "projects": {
    "maintenance-assistant-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "fonts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "maintenance-assistant-frontend:build:production"
            },
            "development": {
              "buildTarget": "maintenance-assistant-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "coverageReporters": ["html", "lcovonly", "text-summary"],
            // THE RATCHET (docs/REFACTOR-STANDARDS.txt, "Enforcement is a RATCHET").
            // Armed 2026-08-24, once the targets were actually met, so a regression fails
            // the build instead of eroding quietly over a series of green pull requests.
            //
            // THE FLOORS ARE THE TARGETS (85), NOT THE ACHIEVED FIGURES. When this was
            // armed the published report read 97.61 statements, 89.88 branches, 96.31
            // functions, 97.69 lines. Arming at those would turn an ordinary refactor red
            // for deleting a covered line it no longer needs, and a gate that fires on
            // harmless work is one people learn to bypass. The margin is working headroom.
            //
            // perFile is deliberately absent, so these are project totals: one small
            // component with an awkward branch must not fail the build on its own.
            //
            // A first-class option of @angular/build:unit-test (22.1.3), read off the
            // builder's own schema.json rather than assumed: "If thresholds are not met,
            // the builder will exit with an error." There is no vitest.config file here,
            // so this is the only mechanism in play.
            "coverageThresholds": {
              "statements": 85,
              "branches": 85,
              "functions": 85,
              "lines": 85
            }
          }
        }
      }
    }
  }
}
