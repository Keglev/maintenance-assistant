# Eclipse compiler options read by the VS Code Java extension (java.settings.url).
# Unchecked conversion from an unannotated library type (the JDK's functional
# interfaces) to a @NonNull type: ignored. Every other null analysis problem keeps
# its default severity. Javac and CI have no null analysis and are unaffected.
org.eclipse.jdt.core.compiler.problem.nullUncheckedConversion=ignore
