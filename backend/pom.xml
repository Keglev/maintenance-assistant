<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.keglevich</groupId>
  <artifactId>maintenance-assistant</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>maintenance-assistant</name>
  <description>AI assistant for searching industrial maintenance protocols</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>3.1.0</springdoc.version>
    <jacoco.version>0.8.13</jacoco.version>
    <testcontainers.version>2.0.5</testcontainers.version>

    <!-- Empty default for the property JaCoCo's prepare-agent fills in. The test
         plugins below extend it with @{argLine}, which fails to resolve if nothing
         ever set it - as happens with -Djacoco.skip=true. -->
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Boot 4's dependency management no longer pins Testcontainers, so the BOM is
           imported here rather than each artifact carrying its own version. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web + operations -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Security: OAuth2 Resource Server validating Keycloak JWTs (ADR-003) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Persistence: PostgreSQL + pgvector (ADR-004). starter-jdbc supplies the
         DataSource that both the driver and Flyway need; JPA follows in Phase 2. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Boot 4 split auto-configuration into per-technology modules: flyway-core is only
         the engine, and without this module there is no FlywayAutoConfiguration, no Flyway
         bean, and `spring.flyway.*` is silently inert. Verified on the classpath, not
         assumed - see FlywayAutoConfigurationIT. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- API documentation: Swagger UI at /swagger-ui.html, spec at /v3/api-docs -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Test: JUnit 5 + Mockito via starter-test, plus Spring Security test support -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers: the ingestion tests run Flyway against a real pgvector image.
         An in-memory database cannot host a vector column or an HNSW index, so the
         alternative is not a cheaper test but no test of the thing that matters. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The ingestion tests wait for work that finishes on another thread. Awaitility polls
         with a deadline instead of sleeping for a guessed duration, which is the difference
         between a test that is slow and one that is flaky. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Already arrives transitively through starter-test. Declared explicitly so
         the ${org.mockito:mockito-core:jar} property the test plugins reference is
         unambiguous, and so the -javaagent wiring below has a visible reason. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 moved MockMvc test auto-configuration out of starter-test into its own module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- Generates META-INF/build-info.properties, which /api/health reports. -->
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Exposes each dependency's resolved path as ${groupId:artifactId:type}, which is
           how the test plugins below point -javaagent at the mockito-core jar without
           hardcoding a version or a repository layout. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>resolve-dependency-paths</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Mockito is attached as an explicit -javaagent rather than letting it attach
           itself at runtime. Self-attachment still works but warns, and the JDK has
           announced it will stop allowing it; this is Mockito's documented replacement.

           @{argLine} is late replacement, not ${argLine}: it expands at execution time
           to whatever JaCoCo's prepare-agent put there, so the two agents combine
           instead of this configuration overwriting the coverage one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>

      <plugin>
        <!-- Integration tests are named *IT and run in the integration-test phase, so a quick
             `mvn test` stays fast while `mvn verify` runs everything. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Same agents as surefire: the integration tests run in their own JVM, which
               inherits nothing from the unit-test one. -->
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <!-- `mvn verify` writes the HTML/XML report to target/site/jacoco/ -->
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
