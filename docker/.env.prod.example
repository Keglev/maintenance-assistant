# Copy to .env.prod on the server and fill in real values:
#   cp .env.prod.example .env.prod
#
# .env.prod is git-ignored and must never be committed. Generate the secrets
# rather than inventing them:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
#
# The deployed file lives at /opt/maintenance-assistant/.env.prod, owned by the
# deploy user with mode 0600.

# --- Public hostnames -------------------------------------------------------
# Both must already resolve to this host: Caddy proves control of them to
# Let's Encrypt over port 80 before it can issue a certificate.
APP_DOMAIN=maintenance.smartsupply.com.de
AUTH_DOMAIN=auth.smartsupply.com.de

# Contact address for the ACME account. Expiry and validation problems are
# mailed here; an unset address means the first warning is an outage.
ACME_EMAIL=admin@smartsupply.com.de

# --- Images -----------------------------------------------------------------
# Per service rather than one shared tag, so one side can be rolled back without
# moving the other. CI publishes :latest and :sha-<commit>, and a rollback is a
# value change here plus `docker compose up -d`.
BACKEND_IMAGE=ghcr.io/keglev/maintenance-assistant/backend:latest
FRONTEND_IMAGE=ghcr.io/keglev/maintenance-assistant/frontend:latest

# --- Application database ---------------------------------------------------
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=generate-me

# --- Keycloak database ------------------------------------------------------
# Separate database and role in the same Postgres instance. Read once, when the
# data directory is initialised; see docker/postgres/init-keycloak-db.sh.
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=generate-me

# --- Keycloak bootstrap admin ----------------------------------------------
# Creates the master-realm administrator on first start. This is the Keycloak
# *server* administrator, not an application user: the four demo users live in
# the imported "maintenance" realm.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=generate-me

# --- LLM provider (ADR-002) -------------------------------------------------
# Only the key is required. Every other value has a working default in the
# compose file, so LEAVE THEM UNSET unless you are deliberately overriding one.
#
# Setting a variable to empty here is not the same as leaving it out: compose
# passes "" through, and an empty value overrides the application's default
# rather than deferring to it. That is what previously sent the backend at an
# empty base URL. If you do not need a value, delete the line.
#
# The key is an IONOS AI Model Hub token from the IONOS Cloud console. Tokens
# have a TTL — a short-lived one will stop ingestion when it expires, so use a
# long-lived token here and keep a copy in the password manager.
LLM_API_KEY=
# Optional overrides. Defaults: the IONOS de-txl endpoint, BAAI/bge-m3, 500.
# LLM_BASE_URL=
# LLM_EMBEDDING_MODEL=
# LLM_DAILY_CALL_BUDGET=
# Query path. Defaults: meta-llama/Llama-3.3-70B-Instruct and 400 answers a day.
# Qwen/Qwen3.5-9B is a supported swap — the application sends the
# reasoning_effort ADR-002 requires on its own — but it was measured worse on
# the production prompt, so it is not a default anyone should reach for lightly.
# LLM_CHAT_MODEL=
# LLM_CHAT_DAILY_CALL_BUDGET=

# --- Ingestion --------------------------------------------------------------
# Both default to false in the compose file and both spend money at the
# provider when true. Neither belongs in the file permanently: they are set for
# one start, then removed.
#
# Bringing up an empty environment, once:
#   1. CORPUS_SEED_ENABLED=true          -> writes the 150 protocols and their
#      docker compose -f docker-compose.prod.yml up -d backend      documents,
#      docker compose logs -f backend    -> "Corpus seed finished: 150 records"
#      all at status RECEIVED. Idempotent; safe to leave on, but remove it.
#   2. INGESTION_BACKLOG_ON_STARTUP=true -> indexes everything at RECEIVED on
#      the next start. ~150 provider calls, well under the daily budget.
#      Or skip this and call the endpoint instead, which is the better habit:
#        POST /api/ingestion/backlog?status=RECEIVED   (admin role)
#   3. Remove both lines and `up -d backend` again.
#
# Re-indexing is idempotent either way: a protocol's chunks are replaced, not
# appended to. Check progress with GET /api/ingestion/status (admin or
# schichtleiter), which also reports today's calls, tokens and estimated cost.
# CORPUS_SEED_ENABLED=false
# INGESTION_BACKLOG_ON_STARTUP=false
